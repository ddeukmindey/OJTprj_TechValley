# Copy file này thành ".env" (cùng cấp docker-compose.yml) rồi điền giá trị thật.
# docker-compose tự đọc file .env ở project root, KHÔNG cần "source" hay export tay.

# "mock"   -> llm-service chạy rule-based, không gọi mạng, không cần API Key.
# "gemini" -> llm-service gọi Gemini API thật (free tier). Cách lấy key: xem README/hướng dẫn.
LLM_PROVIDER=mock

# Dán API Key lấy từ https://aistudio.google.com/apikey vào đây khi LLM_PROVIDER=gemini
LLM_API_KEY=

# Model Gemini free tier, có thể đổi sang gemini-flash nếu tài khoản đã có quyền dùng.
LLM_MODEL=gemini-flash-latest
